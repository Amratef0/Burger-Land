    <ul class="filters_menu nav nav-pills justify-content-center mb-4" id="our_menu">
        <li class="nav-item" role="presentation">
            <button class="nav-link btn btn-secondary btn-sm rounded-pill active" data-id="0" type="button">All</button>
        </li>
        @foreach (var c in Model.Categories ?? Enumerable.Empty<Category>())
        {
            <li class="nav-item" role="presentation">
                <button class="nav-link btn btn-secondary btn-sm rounded-pill" data-id="@c.Id" type="button">@c.Name</button>
            </li>
        }
    </ul>


<div id="products-list">
    @await Html.PartialAsync("_ProductList", Model.Products)
       </div>

    <div class="text-center mt-3">
        <a asp-controller="Main" asp-action="OrderNow" class="btn btn-secondary">
            Discover More
        </a>
    </div>


    <section class="about_section layout_padding">
        <div class="container  ">

            <div class="row">
                <div class="col-md-6 ">
                    <div class="img-box">
                        <img src="/images/about-img.png" alt="">
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="detail-box">
                        <div class="heading_container">
                            <h2>
                                We Are Burger Land
                            </h2>
                        </div>
                        <p>
                            From sizzling grills to your table, every bite is a promise of freshness, quality, and a little bit of joy. We blend premium ingredients with bold ideas to serve burgers that feel familiar—but taste unforgettable, creating moments you’ll savor long after the last bite.
                        </p>
                       
                    </div>
                </div>
            </div>
        </div>
    </section>
    <div id="carouselExampleControls" class="carousel slide" data-ride="carousel" style="margin-top:100px">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img class="d-block w-100" src="/images/369063.jpg" alt="First slide">
                <div class="carousel-caption d-none d-md-block text-left">
                    <h1>Fresh & Delicious</h1>
                    <p>We blend premium ingredients with bold ideas to serve unforgettable taste.</p>
                </div>
            </div>
            <div class="carousel-item">
                <img class="d-block w-100" src="/images/img1.jpg" alt="Second slide">
                <div class="carousel-caption d-none d-md-block text-left">
                    <h1>Quality You Can Trust</h1>
                    <p>From sizzling grills to your table, every bite is a promise of freshness.</p>
                </div>
            </div>
            <div class="carousel-item">
                <img class="d-block w-100" src="/images/last.jpg" alt="Third slide">
                <div class="carousel-caption d-none d-md-block text-left">
                    <h1>Your Favorite Pizza</h1>
                    <p>Experience a mix of comfort and creativity in every burger we make.</p>
                </div>
            </div>
        </div>
        <a class="carousel-control-prev" href="#carouselExampleControls" role="button" data-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="sr-only">Previous</span>
        </a>
        <a class="carousel-control-next" href="#carouselExampleControls" role="button" data-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="sr-only">Next</span>
        </a>
    </div>

    <h2 class="text-white text-center mb-4" style="margin-top:100px;" id="our_booktable">Book A Table</h2>

    <form asp-action="SaveCreateReservation" method="post" class="text-white mx-auto w-50">
        <div class="form-group mb-3">
            <label asp-for="Reservation.Name"></label>
            <input asp-for="Reservation.Name" class="form-control" />
            <span asp-validation-for="Reservation.Name" class="text-white"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Reservation.PhoneNumber"></label>
            <input asp-for="Reservation.PhoneNumber" class="form-control" />
            <span asp-validation-for="Reservation.PhoneNumber" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Reservation.Email"></label>
            <input asp-for="Reservation.Email" class="form-control" />
            <span asp-validation-for="Reservation.Email" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Reservation.ReservationDate"></label>
            <input asp-for="Reservation.ReservationDate" type="date" class="form-control" />
            <span asp-validation-for="Reservation.ReservationDate" class="text-danger"></span>
        </div>

        <div class="form-group mb-4">
            <label asp-for="Reservation.GuestsCount"></label>
            <input asp-for="Reservation.GuestsCount" type="number" class="form-control" min="1" max="20" />
            <span asp-validation-for="Reservation.GuestsCount" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-secondary w-100">Book Now</button>
    </form>

