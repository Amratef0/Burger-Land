    @section Scripts {
        <script>
            var currentPage = 1;

            $('.filters_menu button').click(function() {
                var categoryId = $(this).data('id');
                currentPage = 1;

                $.get('/Main/LoadMoreProducts', { page: currentPage, categoryId: categoryId }, function (html) {
                    $('#products-list').html(html);
                });
            });

            $('#loadMoreBtn').click(function() {
                currentPage++;

                var categoryId = $('.filters_menu button.active').data('id');

                $.get('/Main/LoadMoreProducts', { page: currentPage, categoryId: categoryId }, function (html) {
                    $('#products-list').append(html);
                });
            });
        </script>
    }

    <style>
        .carousel-item img {
            height: 700px; 
            object-fit: cover;
        }

    </style>


</body>

