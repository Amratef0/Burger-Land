@model ReservationSystem.Models.Order

@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="container mt-5">
    <div class="card bg-dark text-white shadow-lg border-0 rounded-3 p-4">
        <div class="text-center mb-4">
            <h2 class="text-success">
                <i class="bi bi-check-circle-fill me-2"></i> Order Confirmation
            </h2>
            <p class="lead">Thank you for your order! 🎉</p>
        </div>

        <div class="mb-4">
            <h5 class="text-info"><i class="bi bi-receipt me-1"></i> Order Details</h5>
            <p><strong>Order ID:</strong> @Model.Id</p>
            <p>
                <strong>Order Date:</strong> @(Model.OrderDate.HasValue
                ? Model.OrderDate.Value.ToString("dd MMM yyyy - hh:mm tt")
                : "N/A")
            </p>
            <p>
                <strong>Total Amount:</strong>
                <span class="text-success">
                    @(Model.TotalAmount.HasValue ? Model.TotalAmount.Value.ToString("C") : "N/A")
                </span>
            </p>
        </div>

        <div class="mb-4">
            <h5 class="text-info"><i class="bi bi-person-circle me-1"></i> Customer Information</h5>
            <p><strong>Name:</strong> @Model.CustomerName</p>
            <p><strong>Address:</strong> @Model.Address</p>
            <p><strong>Phone:</strong> @Model.PhoneNumber</p>
        </div>

        <h5 class="text-info"><i class="bi bi-bag-check me-1"></i> Order Items</h5>
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderItems)
                    {
                        <tr>
                            <td>@item.Product.Name</td>
                            <td>@(item.Price.HasValue ? item.Price.Value.ToString("C") : "N/A")</td>
                            <td>@item.Quantity</td>
                            <td>
                                @(
                                    item.Price.HasValue && item.Quantity.HasValue
                                    ? (item.Price.Value * item.Quantity.Value).ToString("C")
                                    : "N/A"
                                    )
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="text-center mt-4">
            <a asp-controller="Main" asp-action="Index" class="btn btn-dark">
                <i class="bi bi-house-door-fill me-1"></i> Back to Home
            </a>
        </div>
    </div>
</div>
