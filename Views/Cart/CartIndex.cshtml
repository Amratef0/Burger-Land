@model List<ReservationSystem.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-12">
            <div class="card bg-dark text-white shadow-lg border-0 rounded-3">
                <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                    <h3 class="mb-0">
                        <i class="bi bi-cart4 me-2"></i> Shopping Cart
                    </h3>
                </div>
                <div class="card-body p-4">
                    @if (Model == null || !Model.Any())
                    {
                        <div class="alert alert-info text-center mb-0">
                            Your cart is empty.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-dark table-hover align-middle text-center mb-0">
                                <thead class="table-secondary text-dark">
                                    <tr>
                                        <th>Product</th>
                                        <th>Price</th>
                                        <th>Quantity</th>
                                        <th>Total</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.Product.Name</td>
                                            <td>@(item.Product.Price.HasValue ? item.Product.Price.Value.ToString("C") : "-")</td>
                                            <td>
                                                <a asp-action="DecreaseQuantity" asp-route-id="@item.ProductId" class="btn btn-warning btn-sm">
                                                    <i class="bi bi-dash-lg"></i>
                                                </a>
                                                <span class="mx-2">@item.Quantity</span>
                                                <a asp-action="IncreaseQuantity" asp-route-id="@item.ProductId" class="btn btn-success btn-sm">
                                                    <i class="bi bi-plus-lg"></i>
                                                </a>
                                            </td>
                                            <td>@(((item.Product.Price ?? 0) * item.Quantity).ToString("C"))</td>
                                            <td>
                                                <a asp-action="RemoveFromCart" asp-route-id="@item.ProductId" class="btn btn-danger btn-sm">
                                                    <i class="bi bi-trash"></i> Remove
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="mt-4 d-flex justify-content-between align-items-center">
                            <h4>Total: <span class="text-success">@Model.Sum(x => (x.Product.Price ?? 0) * x.Quantity).ToString("C")</span></h4>
                            <div>
                                <a asp-action="Checkout" class="btn btn-dark">
                                    <i class="bi bi-credit-card"></i> Checkout
                                </a>
                                
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
