@model ReservationSystem.Models.Product

@{
    ViewData["Title"] = "Add Product";
}

<div class="container mt-5 bg-dark text-white p-4 rounded">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card bg-secondary text-black shadow-lg border-0 rounded-3">
                <div class="card-header text-center">
                    <h3 class="mb-0">Add Product</h3>
                </div>
                <div class="card-body p-4">

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <p class="mb-0">@error.ErrorMessage</p>
                            }
                        </div>
                    }

                    <form asp-action="SaveAddProduct" asp-controller="Product" method="post">
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control bg-dark text-white border-light" placeholder="Enter product name" />
                            <span asp-validation-for="Name" class="text-warning"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Price" class="form-label"></label>
                            <input asp-for="Price" class="form-control bg-dark text-white border-light" placeholder="Enter price" />
                            <span asp-validation-for="Price" class="text-warning"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ImagePath" class="form-label"></label>
                            <input asp-for="ImagePath" class="form-control bg-dark text-white border-light" placeholder="Enter image URL or path" />
                            <span asp-validation-for="ImagePath" class="text-warning"></span>
                        </div>

                        <div class="mb-3 text-black">
                            <label asp-for="CategoryId" class="form-label text-black"></label>
                            <select asp-for="CategoryId" class="form-select bg-dark text-black border-black" asp-items="ViewBag.Categories">
                                <option value="" class="text-black" style="color:black;">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-black"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-dark btn-lg">Save</button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
