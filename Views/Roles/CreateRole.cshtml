@{
    ViewData["Title"] = "Create Role";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card bg-dark text-white shadow-lg border-0 rounded-3">
                <div class="card-header bg-secondary text-white">
                    <h3 class="mb-0">Create Role</h3>
                </div>
                <div class="card-body">
                    <form asp-action="SaveCreateRole" method="post">
                        <div class="mb-3">
                            <label for="roleName" class="form-label">Role Name</label>
                            <input type="text" name="roleName" id="roleName" class="form-control bg-dark text-white border-secondary" placeholder="Enter role name" />
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="submit" class="btn btn-dark">Create</button>
                            <a asp-action="Index" asp-controller="Role" class="btn btn-dark">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
